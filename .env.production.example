# Production environment for mru.ac.ug (cPanel shared hosting, no SSH).
# Copy to release/laravel/.env, fill in the blanks, and never commit the result.

APP_NAME="Muteesa I Royal University"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mru.ac.ug

# Generate once and keep it. Losing it invalidates every encrypted value and
# every existing session:
#   php artisan key:generate --show
APP_KEY=

APP_TIMEZONE=Africa/Kampala
APP_LOCALE=en

# The commercial surface of the platform this codebase was built from stays
# off on the university domain. CommerceGateTest asserts what this closes.
FEATURE_COMMERCE=false

LOG_CHANNEL=stack
LOG_LEVEL=error

# From cPanel > MySQL Databases. The user, database and password are all
# prefixed with the account name on this host.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# No daemons and no Redis on shared hosting: everything runs in-request,
# backed by the filesystem.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# cPanel > Email Accounts
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@mru.ac.ug"
MAIL_FROM_NAME="${APP_NAME}"

# Development-only tooling. Off, and excluded from the build by
# composer install --no-dev in any case.
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
DEBUGBAR_ENABLED=false
NIGHTWATCH_ENABLED=false
